# Public URLs
PUBLIC_BASE_URL=https://pay.getnexarelay.com
ONE_API_BASE_URL=https://api.getnexarelay.com

# Creem test mode first. Switch to production values only after testing.
CREEM_API_BASE_URL=https://api.creem.io
CREEM_API_KEY=creem_test_xxx
CREEM_WEBHOOK_SECRET=whsec_xxx

# Product IDs from Creem test products.
CREEM_PRODUCT_STARTER=prod_xxx
CREEM_PRODUCT_PLUS=prod_xxx
CREEM_PRODUCT_PRO=prod_xxx

# One API system access token: One API -> 设置 -> 个人设置 -> 生成系统访问令牌.
# Keep this on the server only.
ONE_API_ADMIN_TOKEN=one_api_system_token_xxx

# Most One API deployments accept Authorization: Bearer <token>.
# If yours differs, adjust these two values.
ONE_API_AUTH_HEADER=Authorization
ONE_API_AUTH_SCHEME=Bearer

# Optional: set to "redemption" if direct user quota update is unavailable.
TOPUP_MODE=direct

# Optional shared secret for checkout creation, useful before putting it behind login.
# If set, checkout requests must include ?secret=... or header x-bridge-secret.
BRIDGE_CHECKOUT_SECRET=

PORT=8787
